{
  "name": "job-auto-apply-backend",
  "version": "1.0.0",
  "description": "Multi-Tenant AI-Powered Job Application Automation SaaS Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker:dev": "tsx watch src/queue/worker.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/queue/worker.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "test": "tsx test/run-tests.ts"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.41.0",
    "cors": "^2.8.5",

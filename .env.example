# Environment Configuration for Job Application Automation SaaS

# ── General Server Settings ─────────────────────────────────────
PORT=5000
NODE_ENV=development
API_PREFIX=/api
FRONTEND_URL=http://localhost:5173

# ── Security & Authentication ──────────────────────────────────
JWT_SECRET=saas_jwt_secret_key_production_grade_super_secure_32_chars!
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef  # 32 characters for AES-256

# ── Database (PostgreSQL) ──────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/job_apply_saas
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=job_apply_saas

# ── Cache & Background Queue (Redis) ───────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ── AI Services (Gemini API) ───────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Browser Automation Service ─────────────────────────────────
AUTOMATION_SERVICE_URL=http://localhost:8000
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000

# ── File Uploads ───────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ── Vite Frontend ──────────────────────────────────────────────
VITE_API_URL=http://localhost:5000/api
